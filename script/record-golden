#!/bin/sh
#
# Records the replays under `spec/fixtures/replay` again.
#
# Run it after any change that moves `Game#fingerprint`, which is a change to
# the generator or to a rule. The actions stay as they are and the
# fingerprints are written afresh. `golden.jsonl` gets the streamed scheme
# and `golden-sha256.jsonl` the canonical one.
#
#     script/record-golden

set -e

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

crystal run --no-debug script/golden.cr -- "$root/spec/fixtures/replay/golden.jsonl" sha256s
crystal run --no-debug script/golden.cr -- "$root/spec/fixtures/replay/golden-sha256.jsonl" sha256
