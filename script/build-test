#!/bin/sh
#
# Builds the test build as `bin/crystal-roguelike-test`, linked so that it
# runs on another Mac without Nix or Homebrew.
#
# macOS cannot link libSystem statically. Every other library is linked from
# an archive, so the binary needs only `/usr/lib/libSystem.B.dylib`. The
# script fails when `otool -L` lists anything else.
#
# This script covers macOS. A static Linux binary comes from the Alpine image
# that the release workflow builds in, and the script stops on Linux.
#
# It needs Homebrew with these four formulas, which it checks for and never
# installs: bdw-gc, pcre2, openssl@3 and zlib. It also needs curl, cc, make
# and libtool, and network access on the first run.
#
# GNU libiconv comes from source, because Homebrew's libiconv dylib shadows
# the Nix one. The script downloads the tarball into `.static-libs/src/`,
# checks its SHA-256 and builds a static copy in `.static-libs/libiconv/`.
# A later run skips every step whose result is already there.
#
# `.static-libs/` is scratch. The script refreshes the archives in it on every
# run, and the linker searches it before Homebrew's directories.
#
# `MACOSX_DEPLOYMENT_TARGET` is 14.0 for the libiconv build and the link.
# Homebrew builds its archives for the macOS it runs on, so the link warns
# once for each object file in them that was built for a newer macOS than
# 14.0. There are about 1,100 of those lines, and they bury anything else the
# build says. The script drops exactly those warnings from the build's
# output. Every other line, and the build's exit status, comes through.
#
# Arguments after the script name go to `crystal build` after the fixed ones.
#
#     script/build-test [CRYSTAL BUILD ARGUMENT...]

set -e

if [ "$(uname -s)" != Darwin ]; then
  echo "script/build-test covers macOS only" >&2
  exit 1
fi

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

out=bin/crystal-roguelike-test
libs="$root/.static-libs"

iconv_version=1.19
iconv_url="https://ftp.gnu.org/gnu/libiconv/libiconv-$iconv_version.tar.gz"
# sha256 of the libiconv 1.19 tarball
iconv_sha256=88dd96a8c0464eca144fc791ae60cd31cd8ee78321e67397e25fc095c4a19aa6
iconv_prefix="$libs/libiconv"

MACOSX_DEPLOYMENT_TARGET=14.0
export MACOSX_DEPLOYMENT_TARGET

missing=
for formula in bdw-gc pcre2 openssl@3 zlib; do
  brew list --formula "$formula" >/dev/null 2>&1 || missing="$missing $formula"
done
if [ -n "$missing" ]; then
  echo "missing Homebrew formulas:$missing" >&2
  exit 1
fi

mkdir -p "$libs/src" bin

if [ ! -f "$iconv_prefix/lib/libiconv.a" ]; then
  tarball="$libs/src/libiconv-$iconv_version.tar.gz"
  srcdir="$libs/src/libiconv-$iconv_version"

  if [ ! -f "$tarball" ]; then
    echo "downloading $iconv_url"
    curl -fsSL "$iconv_url" -o "$tarball.part"
    mv "$tarball.part" "$tarball"
  fi

  actual=$(shasum -a 256 "$tarball" | awk '{print $1}')
  if [ "$actual" != "$iconv_sha256" ]; then
    echo "$tarball has sha256 $actual, expected $iconv_sha256" >&2
    rm -f "$tarball"
    exit 1
  fi

  rm -rf "$srcdir"
  tar -xzf "$tarball" -C "$libs/src"

  echo "building libiconv $iconv_version"
  log="$libs/src/libiconv-build.log"
  if ! (
    cd "$srcdir"
    ./configure --enable-static --disable-shared --prefix="$iconv_prefix" CFLAGS="-O2"
    make -j "$(sysctl -n hw.ncpu)"
    make install
  ) >"$log" 2>&1; then
    cat "$log" >&2
    exit 1
  fi
fi

cp -f "$(brew --prefix bdw-gc)/lib/libgc.a" "$libs/"
cp -f "$(brew --prefix pcre2)/lib/libpcre2-8.a" "$libs/"
cp -f "$(brew --prefix openssl@3)/lib/libcrypto.a" "$libs/"
cp -f "$(brew --prefix zlib)/lib/libz.a" "$libs/"

cat > "$libs/iconv_shim.c" <<'C'
/* Crystal calls iconv by its plain names. GNU libiconv exports them with a
   libiconv_ prefix. These three forward one to the other. */
#include <stddef.h>
typedef void *iconv_t;
extern iconv_t libiconv_open(const char *, const char *);
extern size_t libiconv(iconv_t, char **, size_t *, char **, size_t *);
extern int libiconv_close(iconv_t);
iconv_t iconv_open(const char *to, const char *from) { return libiconv_open(to, from); }
size_t iconv(iconv_t cd, char **in, size_t *inleft, char **out, size_t *outleft) { return libiconv(cd, in, inleft, out, outleft); }
int iconv_close(iconv_t cd) { return libiconv_close(cd); }
C

cc -O2 -c "$libs/iconv_shim.c" -o "$libs/iconv_shim.o"
rm -f "$libs/libiconv.a"
libtool -static -o "$libs/libiconv.a" "$libs/iconv_shim.o" "$iconv_prefix/lib/libiconv.a"

newer='^ld: warning: object file \(.*\) was built for newer macOS version \([0-9.]+\) than being linked \([0-9.]+\)$'
status="$libs/build.status"

exec 3>&1
{
  code=0
  crystal build --release --no-debug -Dtest_build -o "$out" src/main.cr \
    --link-flags "-L$libs" "$@" 2>&1 1>&3 3>&- || code=$?
  echo "$code" >"$status"
} | { grep -v -E "$newer" || true; } 1>&2
exec 3>&-

code=$(cat "$status")
[ "$code" -eq 0 ] || exit "$code"

otool -L "$out"
"$out" --version

stray=$(otool -L "$out" | sed 1d | awk '{print $1}' | grep -v '^/usr/lib/libSystem.B.dylib$' || true)
if [ -n "$stray" ]; then
  echo "$out links a library besides libSystem: $stray" >&2
  exit 1
fi
